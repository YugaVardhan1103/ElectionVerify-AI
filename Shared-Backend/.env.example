# ==============================================================================
# ElectionVerify AI - Backend Environment Configuration Example
# Copy this file to '.env' and populate with your environment-specific values.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# MongoDB Connection String
# Local instance or MongoDB Atlas URI (e.g., mongodb+srv://<user>:<password>@cluster.mongodb.net/electionverify)
MONGODB_URI=mongodb://127.0.0.1:27017/electionverify

# JSON Web Token Secret & Expiration
# IMPORTANT: Generate a strong, random 256-bit string in production!
JWT_SECRET=replace_this_with_a_secure_random_jwt_secret_key_in_production
JWT_EXPIRES_IN=7d

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed client origins (React SPA, Next.js, etc.)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:4173,https://electionverify-react.vercel.app

# ------------------------------------------------------------------------------
# AI Verification Engine Configuration
# ------------------------------------------------------------------------------
# Provider Selection: 'auto', 'gemini', 'openai', or 'unconfigured'
# If set to 'auto', uses Gemini if GEMINI_API_KEY is present, then OpenAI, or falls back to 'unconfigured'
AI_PROVIDER=gemini

# Google Gemini API Credentials
# Obtain from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Credentials
# Obtain from https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Evidence Retrieval & Search Provider Configuration
# ------------------------------------------------------------------------------
# Provider Selection: 'tavily', 'google', or 'unconfigured'
SEARCH_PROVIDER=tavily

# Tavily Search API Credentials
# Obtain from https://tavily.com
TAVILY_API_KEY=

# Google Custom Search API Credentials (Alternative)
# Obtain API key from Google Cloud Console and Search Engine ID (CX) from Programmable Search Engine
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# ------------------------------------------------------------------------------
# OAuth 2.0 Providers (Google & Facebook / Meta)
# ------------------------------------------------------------------------------
# Google OAuth Client ID & Secret
# Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook / Meta App ID & App Secret
# Obtain from https://developers.facebook.com/apps
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ------------------------------------------------------------------------------
# Cloudinary Evidence Proof Storage
# ------------------------------------------------------------------------------
# Obtain from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# Rate Limiting Controls
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=20

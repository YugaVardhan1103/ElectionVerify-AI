# ==============================================================================
# ElectionVerify AI - Next.js Frontend Configuration
# ==============================================================================

# Shared-Backend REST API Base URL
# Default local endpoint of the Shared-Backend service
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# Social OAuth Authentication (Google & Facebook)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client ID
# Configured in Google Cloud Console with authorized JS origin matching your site
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Facebook / Meta App ID
# Configured in Meta for Developers with App Domains set to your site
NEXT_PUBLIC_FACEBOOK_APP_ID=

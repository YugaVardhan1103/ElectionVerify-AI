# ==============================================================================
# ElectionVerify AI - Next.js Frontend Configuration
# ==============================================================================

# Shared-Backend REST API Base URL
# Default local endpoint of the Shared-Backend service
API_URL=http://localhost:5000/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# Social OAuth Authentication (Public Client IDs)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client ID
# Configured in Google Cloud Console with authorized JS origin matching your site
GOOGLE_CLIENT_ID=

# Facebook / Meta App ID
# Configured in Meta for Developers with App Domains set to your site
FACEBOOK_APP_ID=

# ------------------------------------------------------------------------------
# Authentication Secrets & Client Secrets (STRICTLY SERVER-SIDE)
# Never prefix secrets with NEXT_PUBLIC_ or expose them to client bundles.
# ------------------------------------------------------------------------------
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_SECRET=
# JWT_SECRET=

# ------------------------------------------------------------------------------
# Prisma ORM MongoDB Configuration (STRICTLY SERVER-SIDE)
# Database Name: electionverify_nextjs
# Format for Local MongoDB:
#   DATABASE_URL="mongodb://127.0.0.1:27017/electionverify_nextjs"
# Format for MongoDB Atlas Cluster:
#   DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-host>/electionverify_nextjs?retryWrites=true&w=majority"
# ------------------------------------------------------------------------------
DATABASE_URL="mongodb://127.0.0.1:27017/electionverify_nextjs"
